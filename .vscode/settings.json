{
  // Die Praeambel laedt fontspec/\setmonofont{JuliaMono} -> pdflatex kann das
  // nicht, es muss lualatex sein. minted braucht zusaetzlich -shell-escape und
  // pygmentize, das unter ~/Library/Python/3.9/bin liegt (nicht im Standard-PATH
  // von VS Code), daher der explizite PATH unten.
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-lualatex",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-shell-escape",
        "-lualatex",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ],
      "env": {
        "PATH": "/Users/marasilge/Library/Python/3.9/bin:/Library/TeX/texbin:/usr/bin:/bin:/usr/sbin:/sbin"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (lualatex + shell-escape)",
      "tools": ["latexmk-lualatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "first"
}
