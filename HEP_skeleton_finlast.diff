  sumMap_eq_SkelProj_LtOrSphere       hx : ↑n < m ∨ ↑n = m ∧ ...
                                          -> n < Fin.last m ∨ n = Fin.last m ∧ ...
  TopOpen                             ↑n_y = m         -> n_y = Fin.last m
  SkeletonProj_inj_top                hnm : ↑n = m     -> hnm : n = Fin.last m

